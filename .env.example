# Copy to .env and fill in. Everything is optional: without keys the app still runs
# with the built-in offline tutor and the best natural voice installed on the device.

# --- AI tutor brain (Claude) ---
ANTHROPIC_API_KEY=
KIDDOS_MODEL=claude-opus-5-5

# --- Human-sounding AI voices (fast, streamed sentence by sentence) ---
# auto = the first one below that has a key; otherwise the best voice on the device.
TTS_PROVIDER=auto

# 1) FREE: Azure AI Speech, free tier (F0) = 500,000 characters a month, never billed.
#    The same very human "Natural" voices as Microsoft Edge (Ava, Andrew, Emma, Brian).
#    Azure portal > Create "Speech service" > Pricing tier "Free F0" > Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# 2) CHEAP: OpenAI speech (gpt-4o-mini-tts, about $0.015 a minute). Either put the key here...
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# ...or use the key already saved in Supabase: `npx supabase login`, then `node deploy/setup-voice.mjs`
# (it fills these two in).
KIDDOS_TTS_URL=
KIDDOS_TTS_TOKEN=

# 3) PREMIUM: ElevenLabs Flash (most expressive, paid).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Server ---
API_PORT=8787
# Where the mobile/desktop apps reach the API when not served from it (e.g. https://api.kiddos.example)
VITE_API_BASE=
