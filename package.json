{
  "name": "kiddos",
  "productName": "Kiddos",
  "version": "1.0.0",
  "description": "Kiddos - the AI study buddy that listens, talks, points and writes. Web, Windows, macOS, Linux, iOS and Android from one codebase.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Agape Care",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && npm run build:server && electron .",
    "desktop:dev": "concurrently -k \"npm:dev\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "dist:win": "npm run build && npm run build:server && electron-builder --win",
    "dist:mac": "npm run build && npm run build:server && electron-builder --mac",
    "dist:linux": "npm run build && npm run build:server && electron-builder --linux",
    "mobile:add": "cap add ios && cap add android",
    "mobile:sync": "npm run build && cap sync",
    "ios": "npm run mobile:sync && cap open ios",
    "android": "npm run mobile:sync && cap open android",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=electron/server.cjs --log-level=warning"
  },
  "build": {
    "appId": "care.agape.kiddos",
    "productName": "Kiddos",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "icon": "build/icon.png",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Kiddos"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "undici": "^6.21.3",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
